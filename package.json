{
  "name": "nesy-collage",
  "version": "0.1.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "playwright test",
    "desktop": "node scripts/release.mjs desktop",
    "release": "node scripts/release.mjs all",
    "release:win": "node scripts/release.mjs win",
    "release:linux": "node scripts/release.mjs linux",
    "test:desktop": "node scripts/smoke-desktop.mjs",
    "build:pwa": "ng build --output-path dist/pwa",
    "release:pwa": "node scripts/release-pwa.mjs",
    "preview:pwa": "node scripts/serve-pwa.mjs",
    "test:pwa": "node scripts/release-pwa.mjs && playwright test --config playwright.pwa.config.ts"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "22.0.2",
    "@fontsource/caveat": "^5.3.0",
    "exifr": "^7.1.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.3",
    "@angular/cli": "^22.0.3",
    "@angular/compiler-cli": "^22.0.0",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "fake-indexeddb": "^6.2.7",
    "fflate": "^0.8.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "packageManager": "pnpm@11.8.0"
}
